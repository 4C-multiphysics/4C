# Exit the script at the first failure
set -e

# set the field separator to new line
IFS=$'\n'

# test all changed files
for file in "$@"
do
# check if there are non-ascii characters in the file
  grep_status=0
  matches=$(LC_ALL=C grep -n '[^[:print:][:cntrl:]]' "$file") || grep_status=$?
  if [ "$grep_status" -gt 1 ]; then
    exit "$grep_status"
  fi

  if [ -n "$matches" ]; then
    while IFS= read -r match; do
      line_number=${match%%:*}
      line_content=${match#*:}
      non_ascii_error+="${file}:${line_number}: ${line_content}"$'\n'
    done <<< "$matches"
  fi
done

# printout for non-ascii characters
if [ -n "$non_ascii_error" ]
then
  printf "\nThe following lines contain non-ASCII characters:\n\n"
  printf "%s" "$non_ascii_error"
  printf "\n--> Please remove the non-ASCII characters shown above\n"
exit 1
fi

exit 0
