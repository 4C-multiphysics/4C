TITLE:
  - "0D Reduced Lung Performance Benchmark"
  - "Units are mm, g, s"
  - "Pressure in g/mm/s^2 = 1e-2 mbar"
PROBLEM TYPE:
  PROBLEMTYPE: "Reduced_Lung"
reduced_dimensional_lung:
  air_properties:
    density: 1.176e-06
    dynamic_viscosity: 1.79105e-05
  dynamics:
    linear_solver: 1
    number_of_steps: 75
    restart_every: 76
    results_every: 76
    time_increment: 0.1
    max_nonlinear_iterations: 15
    nonlinear_residual_tolerance: 1e-8
    nonlinear_increment_tolerance: 1e-8
    output_verbosity: medium
  lung_tree:
    topology:
      num_nodes: @NUM_NODES@
      num_elements: @NUM_ELEMENTS@
      node_coordinates:
        from_file: "@MESH_FILE@"
      element_nodes:
        from_file: "@MESH_FILE@"
    element_type:
      from_file: "@MESH_FILE@"
    generation:
      from_file: "@MESH_FILE@"
    airways:
      radius:
        from_file: "@MESH_FILE@"
      flow_model:
        resistance_type:
          constant: NonLinear
        include_inertia:
          constant: false
      wall_model_type:
        constant: Rigid
    terminal_units:
      rheological_model:
        rheological_model_type:
          constant: KelvinVoigt
        kelvin_voigt:
          viscosity_kelvin_voigt_eta:
            constant: 10.0
      elasticity_model:
        elasticity_model_type:
          constant: Ogden
        ogden:
          ogden_parameter_kappa:
            constant: 9000.0
          ogden_parameter_beta:
            constant: -12
  boundary_conditions:
    num_conditions: @NUM_CONDITIONS@
    bc_type:
      from_file: "@MESH_FILE@"
    bc_node_id:
      from_file: "@MESH_FILE@"
    boundary_value:
      bc_function_id:
        from_file: "@MESH_FILE@"
SOLVER 1:
  SOLVER: "UMFPACK"
  NAME: "Reduced_lung_solver"
FUNCT1:
- SYMBOLIC_FUNCTION_OF_TIME: 1000*flow_ml_s
- VARIABLE: 0
  NAME: flow_ml_s
  TYPE: linearinterpolation
  NUMPOINTS: 163
